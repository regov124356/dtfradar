ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
# Klucze z sandboxa (https://apps.developer.allegro.pl.allegrosandbox.pl) - do testow:
ALLEGRO_SANDBOX_CLIENT_ID=
ALLEGRO_SANDBOX_CLIENT_SECRET=
# Opcjonalnie, domyslnie zarejestrowany User-Agent:
# ALLEGRO_USER_AGENT=DtfRadar/0.1.0 (+https://github.com/regov124356/dtfradar)
